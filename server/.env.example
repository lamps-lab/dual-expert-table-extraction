# ODU gateway: obtain an API key and an exact available model ID via its SSO page.
LLM_BASE_URL=https://llm.cs.odu.edu/v1
LLM_API_KEY=
LLM_MODEL=gemma-4-31b
LLM_RESPONSE_FORMAT=json_schema
# Enable for the vLLM chat-template setting used in the research notebooks.
LLM_DISABLE_THINKING=true
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=16384

# Optional per-expert overrides: VISION_BASE_URL, TEXT_BASE_URL,
# VISION_API_KEY, TEXT_API_KEY, VISION_MODEL, TEXT_MODEL.
NOUGAT_MODEL=facebook/nougat-base
NOUGAT_DEVICE=cuda
NOUGAT_MAX_TOKENS=4095
NOUGAT_TIMEOUT_SECONDS=240
# ROUTER_PATH=/app/server/artifacts/router_a25.joblib
